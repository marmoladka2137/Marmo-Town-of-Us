<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/MTOU</PathMap>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.1.0-beta</Version>
    <AssemblyVersion>1.1.0.18</AssemblyVersion>
    <FileVersion>1.1.0.18</FileVersion>
    <InformationalVersion>1.1.0 Beta</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <RootNamespace>TouMarmo</RootNamespace>
    <AssemblyName>TOU-Marmo</AssemblyName>
    <Description>Marmo Town of Us - integrated Town of Us Mira + MTOU roles.</Description>
    <GameRoot Condition="'$(GameRoot)' == ''">$(AMONG_US_ROOT)</GameRoot>
    <DefineConstants>$(DefineConstants);MTOU_INTEGRATED</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(GameRoot)\BepInEx\core\*.dll" Exclude="$(GameRoot)\BepInEx\core\dobby.dll" Private="false" />
    <Reference Include="$(GameRoot)\BepInEx\interop\*.dll" Private="false" />
    <Reference Include="MiraAPI" HintPath="$(GameRoot)\BepInEx\plugins\MiraAPI.dll" Private="false" />
    <Reference Include="Reactor" HintPath="$(GameRoot)\BepInEx\plugins\Reactor.dll" Private="false" />
    <Reference Include="CorsacCosmetics" HintPath="$(GameRoot)\BepInEx\plugins\CorsacCosmetics.dll" Private="false" />
    <!-- TownOfUsMira.dll reference removed: integrated into this assembly -->
  </ItemGroup>

  <ItemGroup>
    <!-- MTOU resources -->
    <EmbeddedResource Include="Resources\**\*.*" />
  </ItemGroup>

  <!-- Integrated Town of Us Mira sources and resources (compiled as part of this mod) -->
  <ItemGroup>
    <Compile Remove="external\**\*.cs;tools\**\*.cs;vendor\**\*.cs" />
    <!-- Achievement integration is removed; retain upstream source only as provenance. -->
    <Compile Remove="IntegratedTownOfUs\Modules\AchievementsAPIBridge.cs" />
    <EmbeddedResource Remove="external\**\*.*" />


    <!-- Avoid duplicate role implementations: keep MTOU's Composter (TouMarmo.*) as the active one -->
    <Compile Remove="IntegratedTownOfUs\Roles\Classic\Crewmate\CrewmateKilling\ComposterRole.cs" />
    <Compile Remove="IntegratedTownOfUs\Options\Roles\Crewmate\ComposterOptions.cs" />
    <Compile Remove="IntegratedTownOfUs\Buttons\Classic\Crewmate\CrewmateKilling\ComposterPlaceTrapButton.cs" />
    <Compile Remove="IntegratedTownOfUs\Modules\CompostTrap.cs" />
    <Compile Remove="IntegratedTownOfUs\Assets\ComposterAssets.cs" />
    <Compile Remove="IntegratedTownOfUs\Events\ComposterEvents.cs" />
    <Compile Remove="IntegratedTownOfUs\Events\Crewmate\ComposterEvents.cs" />

    <EmbeddedResource Include="IntegratedTownOfUs\modinfo.json" LogicalName="modinfo.json" Condition="Exists('IntegratedTownOfUs\modinfo.json')" />
  </ItemGroup>

  <!-- Embed TOU resources preserving logical names expected by TouAssets/LoadableResourceAsset (TownOfUs.Resources.*) -->
  <ItemGroup>
    <TouResource Include="IntegratedTownOfUs\Resources\**\*.*" />
    <EmbeddedResource Include="@(TouResource)">
      <LogicalName>TownOfUs.Resources.$([System.String]::Copy('%(RecursiveDir)%(Filename)%(Extension)').Replace('\', '.').Replace('/', '.'))</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <!-- Reference API only: Perfect Comms is an optional runtime integration. -->
    <PackageReference Include="PerfectComms.Api" Version="4.1.7.1" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameRoot)/BepInEx/interop/Assembly-CSharp.dll')" Text="Set AMONG_US_ROOT or -p:GameRoot to a legally owned Among Us installation initialized with BepInEx IL2CPP." />
    <Error Condition="!Exists('$(GameRoot)/BepInEx/plugins/MiraAPI.dll') Or !Exists('$(GameRoot)/BepInEx/plugins/Reactor.dll') Or !Exists('$(GameRoot)/BepInEx/plugins/CorsacCosmetics.dll')" Text="The development installation needs MiraAPI, Reactor and CorsacCosmetics. See DEPENDENCIES.md." />
  </Target>

  <ItemGroup>
    <!-- Restore original clips/renderers. Keep only the independent rejoin clock code. -->
    <Compile Remove="Modules/OriginalMotion/Original*.cs" />
    <Compile Remove="IntegratedTownOfUs/Buttons/Classic/Neutral/NeutralEvil/ExeTormentButton.cs" />
    <EmbeddedResource Remove="Resources/OriginalMotion/**/*.*" />
  </ItemGroup>
</Project>








